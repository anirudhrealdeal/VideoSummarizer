# Ara SDK credentials
ARA_API_KEY=your_ara_api_key_here
ARA_RUNTIME_KEY=         # filled in after: ara deploy app.py
ARA_APP_HEADER_KEY=      # filled in after: ara setup-auth app.py

# SMTP for sending emails (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password  # use a Gmail App Password, not your main password

# Paste the webhook URL printed after deploy into backend .env
# ARA_WEBHOOK_URL=https://api.ara.so/v1/apps/<app_id>/endpoints/organize
