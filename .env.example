# OpenAI
OPENAI_API_KEY=sk-...

# SMTP — used for summary email + 7-day review reminder
# For Gmail: enable 2FA, then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# Production URLs (set these when deploying)
# API_BASE_URL is what the backend uses to build download links returned to the frontend
API_BASE_URL=https://your-backend.railway.app
# CORS_ORIGINS is a comma-separated list of allowed frontend origins
CORS_ORIGINS=https://your-frontend.vercel.app

# Scheduler DB path (already set to /data in Docker)
SCHEDULER_DB_PATH=/data/vlm_scheduler.db
